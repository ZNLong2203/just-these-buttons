# Gemini API key from https://aistudio.google.com/apikey — use a paid-tier key,
# so photos are not used to improve Google's products.
GEMINI_API_KEY=
# Optional: the vision model (default gemini-3.8-flash).
GEMINI_MODEL=
# Optional: the image model the probe uses to generate test photos.
GEMINI_IMAGE_MODEL=
# Optional: total requests the app will send to Gemini per day (default 300).
DAILY_LIMIT=
