{
  "name": "just-these-buttons",
  "version": "0.1.0",
  "private": true,
  "description": "Photograph a machine, name one task, and print a card that shows only the buttons that task needs.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "probe:photos": "tsx --env-file-if-exists=.env.local scripts/make-probe-photos.ts",
    "probe": "tsx --env-file-if-exists=.env.local scripts/probe.ts"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
